# Public base URL (badges, canonical links, OpenAPI servers)
NEXT_PUBLIC_SITE_URL=https://ciss.example.com
# SQLite file for claims & scan cache (Node >= 22.13 built-in node:sqlite)
CISS_DB_PATH=.data/ciss.db
# Enables claim review (Authorization: Bearer <token>). Unset = review disabled.
CISS_ADMIN_TOKEN=
# Optional: raise Repo Scan rate limits on each host
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=
