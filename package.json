{
  "name": "ciss",
  "version": "0.1.0",
  "private": true,
  "description": "CISS — Code Information Sharing Service: algorithm origin & lineage credit registry",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "CISS_STATIC=1 next build && tsx --tsconfig tsconfig.json scripts/export-static.mts out",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:sources": "tsx scripts/verify-sources.mts",
    "catalog": "tsx --tsconfig tsconfig.json scripts/export-catalog.mts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
